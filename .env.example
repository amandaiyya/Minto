# Required server-side Better Auth secret (at least 32 characters).
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Canonical application origin; optional in development (defaults to http://localhost:3000), required as HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000

# Required MongoDB connection string used by the server.
MONGODB_URI=replace-with-your-mongodb-connection-string
